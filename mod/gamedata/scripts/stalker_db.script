--[[
    Item catalog: gamedata/configs/db/*.json (site pack dump).
    Item groups use the site file slug (pistols, artefacts, ...).
    Unions: weapons, weapon-attach, armor.
    Missing files are empty. craft-recipes.json is a recipe index.
    db/lang picks translations (en/ru/fr). Raw JSON keys are kept.
]]

local ROOT = "db\\"
local loaded = false
local names = {}
local by_id = {}
local groups = {}
local in_group = {}
local EMPTY = {}
local list_sorted = {}
local recipes = {}
local by_name = {}

-- site slugs; misc last so a real cat wins on duplicate id
local ITEM_FILES = {
    "pistols.json",
    "smgs.json",
    "rifles.json",
    "snipers.json",
    "shotguns.json",
    "melee.json",
    "launchers.json",
    "scopes.json",
    "silencers.json",
    "grenade-launchers.json",
    "tactical-kits.json",
    "weapon-parts.json",
    "outfits.json",
    "helmets.json",
    "ammo.json",
    "mutant-parts.json",
    "outfit-parts.json",
    "medicine.json",
    "food.json",
    "artefacts.json",
    "explosives.json",
    "belt-attachments.json",
    "magazines.json",
    "misc.json",
}

local UNIONS = {
    weapons = {
        "pistols", "smgs", "rifles", "snipers", "shotguns", "melee", "launchers",
    },
    ["weapon-attach"] = { "scopes", "silencers", "grenade-launchers" },
    armor = { "outfits", "helmets" },
}

local try_read_path = function(getFS, rel)
    return getFS():update_path("$game_config$", rel)
end

local try_open = function(abs)
    return io.open(abs, "r")
end

local function read_text(rel)
    if not (getFS and getFS().update_path) then
        return nil
    end
    local ok, abs = pcall(try_read_path, getFS, rel)
    if not (ok and abs and abs ~= "") then
        return nil
    end
    local okf, f = pcall(try_open, abs)
    if not (okf and f) then
        return nil
    end
    local s = f:read("*a")
    f:close()
    if s and s ~= "" then
        return s
    end
    return nil
end

local function decode_file(file)
    file = file:gsub("/", "\\")
    local text = read_text(ROOT .. file)
    if not text then
        return nil, "missing"
    end
    local ok, data = pcall(stalker_db_json.decode, text)
    if ok then
        return data
    end
    printf("STALKER_DB: failed to decode %s", file)
    return nil, "bad"
end

local function read_lang()
    local text = read_text(ROOT .. "lang")
    local lang = text and text:match("[A-Za-z]+")
    if lang then
        return string.lower(lang)
    end
    return "en"
end

local function tr(s)
    if type(s) ~= "string" or s == "" then
        return s
    end
    return names[string.lower(s)] or s
end

local function decorate(row)
    local key = row.displayName or row.pda_encyclopedia_name
    row.name = key and tr(key) or (row.id or "")
    if row.st_data_export_description then
        row.descr = tr(row.st_data_export_description)
    end
    return row
end

local function add_row(typ, row)
    if not (row and row.id) then
        return false
    end
    if by_id[row.id] then
        printf("STALKER_DB: skip duplicate id %s", row.id)
        return false
    end
    if row.displayName then
        by_name[row.displayName] = row.id
        by_name[string.lower(row.displayName)] = row.id
    end
    if row.pda_encyclopedia_name then
        by_name[row.pda_encyclopedia_name] = row.id
        by_name[string.lower(row.pda_encyclopedia_name)] = row.id
    end
    decorate(row)
    by_id[row.id] = row
    local g = groups[typ]
    g[#g + 1] = row
    return true
end

local function concat(types)
    local out = {}
    for i = 1, #types do
        local g = groups[types[i]]
        if g then
            for j = 1, #g do
                out[#out + 1] = g[j]
            end
        end
    end
    return out
end

local function index_all()
    in_group = {}
    for typ, rows in pairs(groups) do
        local idx = {}
        for i = 1, #rows do
            local id = rows[i].id
            if id then
                idx[id] = true
            end
        end
        in_group[typ] = idx
    end
end

local function load_names()
    local data = decode_file("translations.json")
    names = {}
    if not data then
        printf("STALKER_DB: names missing")
        return
    end
    local lang = read_lang()
    if type(data[lang]) == "table" then
        names = data[lang]
        printf("STALKER_DB: names %s", lang)
        return
    end
    if type(data.en) == "table" then
        names = data.en
        printf("STALKER_DB: names en (no %s)", lang)
        return
    end
    printf("STALKER_DB: names missing")
end

local function parse_amount(s)
    if type(s) == "number" then
        return math.floor(s)
    end
    local n = tostring(s or ""):match("(%d+)")
    return tonumber(n) or 0
end

local function load_recipes()
    recipes = {}
    local data = decode_file("craft-recipes.json")
    if not data then
        return
    end
    local missed = 0
    for _, cat in pairs(data) do
        local items = cat and cat.items
        if items then
            for i = 1, #items do
                local it = items[i]
                if it and it.id and it.ingredients then
                    local parts = {}
                    for j = 1, #it.ingredients do
                        local ing = it.ingredients[j]
                        local key = ing and ing.name
                        local sec = key and (by_name[key] or by_name[string.lower(key)] or (by_id[key] and key))
                        if sec then
                            parts[#parts + 1] = { sec, parse_amount(ing.amount) }
                        else
                            missed = missed + 1
                            printf("STALKER_DB: craft miss %s ingredient %s", it.id, tostring(key))
                        end
                    end
                    recipes[it.id] = parts
                end
            end
        end
    end
    if missed > 0 then
        printf("STALKER_DB: craft unmatched ingredients %s", missed)
    end
end

local function slug(file)
    return file:sub(1, #file - 5)
end

local function load_all()
    if loaded then
        return
    end
    loaded = true
    by_id = {}
    groups = {}
    recipes = {}
    by_name = {}
    load_names()
    local ok_files = 0
    local miss_files = 0
    local n_items = 0
    for i = 1, #ITEM_FILES do
        local file = ITEM_FILES[i]
        local typ = slug(file)
        groups[typ] = {}
        local data, err = decode_file(file)
        local items = data and data.items
        if items then
            ok_files = ok_files + 1
            for j = 1, #items do
                if add_row(typ, items[j]) then
                    n_items = n_items + 1
                end
            end
        elseif err == "missing" then
            miss_files = miss_files + 1
        end
    end
    for name, types in pairs(UNIONS) do
        groups[name] = concat(types)
    end
    index_all()
    load_recipes()
    printf("STALKER_DB: loaded %s items from %s files (%s missing)", n_items, ok_files, miss_files)
end

local function ensure()
    if not loaded then
        load_all()
    end
end

local function cmp(key, desc)
    return function(a, b)
        local va, vb = a[key], b[key]
        local na, nb = tonumber(va), tonumber(vb)
        if na and nb then
            va, vb = na, nb
        else
            va = tostring(va or "")
            vb = tostring(vb or "")
        end
        if va == vb then
            return false
        end
        if desc then
            return va > vb
        end
        return va < vb
    end
end

function get(id, typ)
    ensure()
    if not id then
        return nil
    end
    local row = by_id[id]
    if not row then
        return nil
    end
    if typ then
        local idx = in_group[typ]
        if not (idx and idx[id]) then
            return nil
        end
    end
    return row
end

function is(id, typ)
    ensure()
    if not (id and typ) then
        return false
    end
    local idx = in_group[typ]
    return idx and idx[id] == true
end

function is_any(id, types)
    if not (id and types) then
        return false
    end
    for i = 1, #types do
        if is(id, types[i]) then
            return true
        end
    end
    return false
end

function translate(key)
    ensure()
    return tr(key)
end

function json(file)
    ensure()
    if not file then
        return nil
    end
    local data = decode_file(file)
    return data
end

function craft(id)
    ensure()
    return id and recipes[id] or nil
end

function list(typ, sort, dir)
    ensure()
    local src = typ and groups[typ]
    if not src then
        return EMPTY
    end
    if not sort then
        return src
    end
    local key = typ .. "\0" .. sort .. "\0" .. (dir or "")
    local hit = list_sorted[key]
    if hit then
        return hit
    end
    local out = {}
    for i = 1, #src do
        out[i] = src[i]
    end
    table.sort(out, cmp(sort, dir == "desc"))
    list_sorted[key] = out
    return out
end

function on_game_start()
    load_all()
end

rawset(_G, "STALKER_DB", stalker_db)
