--[[
    Item catalog: gamedata/configs/db/*.json (site pack dump).
    init() loads every shipped JSON. Item groups are top-level files with items[].id
    (materials skipped: ids collide with medicine; misc last).
    Unions: weapons, weapon-attach, armor.
    craft() returns the raw recipe plus name/descr.
    db/lang picks translations (en/ru/fr). Raw JSON keys are kept.
    Default get/list/json/craft return sealed proxies (writes logged and ignored).
    open(mod_id) during load returns a handle with a private deep-copy cache.
]]

local ROOT = "db\\"
local loaded = false
local names = {}
local by_id = {}
local by_id_raw = {}
local groups = {}
local groups_raw = {}
local in_group = {}
local EMPTY = {}
local list_sorted = {}
local recipes = {}
local recipes_raw = {}
local json_raw = {}
local json_sealed = {}
local views = {}
local view_n = 0
local can_open = true
local raw_of = {}
local proxy_of = {}
local write_warned = {}

local UNIONS = {
    weapons = {
        "pistols", "smgs", "rifles", "snipers", "shotguns", "melee", "launchers",
    },
    ["weapon-attach"] = { "scopes", "silencers", "grenade-launchers" },
    armor = { "outfits", "helmets" },
}

local SKIP_GROUP = {
    ["materials.json"] = true,
    ["pack-files.json"] = true,
    ["translations.json"] = true,
}

local try_read_path = function(getFS, rel)
    return getFS():update_path("$game_config$", rel)
end

local try_open = function(abs)
    return io.open(abs, "r")
end

local function read_text(rel)
    if not (getFS and getFS().update_path) then
        return nil
    end
    local ok, abs = pcall(try_read_path, getFS, rel)
    if not (ok and abs and abs ~= "") then
        return nil
    end
    local okf, f = pcall(try_open, abs)
    if not (okf and f) then
        return nil
    end
    local s = f:read("*a")
    f:close()
    if s and s ~= "" then
        return s
    end
    return nil
end

local function norm_file(file)
    return file:gsub("/", "\\")
end

local RO = { __metatable = false }

local function seal_one(raw)
    if type(raw) ~= "table" then
        return raw
    end
    local p = proxy_of[raw]
    if p then
        return p
    end
    p = {}
    proxy_of[raw] = p
    raw_of[p] = raw
    setmetatable(p, RO)
    for _, v in pairs(raw) do
        if type(v) == "table" then
            seal_one(v)
        end
    end
    return p
end

function RO.__index(p, k)
    local raw = raw_of[p]
    if not raw then
        return nil
    end
    local v = raw[k]
    if type(v) == "table" then
        return seal_one(v)
    end
    return v
end

function RO.__newindex(p, k)
    if write_warned[p] then
        return
    end
    write_warned[p] = true
    local raw = raw_of[p]
    local id = raw and raw.id or "?"
    printf("STALKER_DB: ignore write id=%s key=%s", tostring(id), tostring(k))
end

local function decode_file(file)
    file = norm_file(file)
    local hit = json_raw[file]
    if hit ~= nil then
        return hit
    end
    local text = read_text(ROOT .. file)
    if not text then
        json_raw[file] = false
        return nil, "missing"
    end
    local ok, data = pcall(stalker_db_json.decode, text)
    if ok then
        json_raw[file] = data
        return data
    end
    json_raw[file] = false
    printf("STALKER_DB: failed to decode %s", file)
    return nil, "bad"
end

local function read_lang()
    local text = read_text(ROOT .. "lang")
    local lang = text and text:match("[A-Za-z]+")
    if lang then
        return string.lower(lang)
    end
    return "en"
end

local function tr(s)
    if type(s) ~= "string" or s == "" then
        return s
    end
    return names[string.lower(s)] or s
end

local function decorate(row)
    local key = row.displayName or row.pda_encyclopedia_name
    row.name = key and tr(key) or (row.id or "")
    if row.st_data_export_description then
        row.descr = tr(row.st_data_export_description)
    end
    return row
end

local function add_row(typ, row)
    if not (row and row.id) then
        return false
    end
    if by_id[row.id] then
        printf("STALKER_DB: skip duplicate id %s", row.id)
        return false
    end
    decorate(row)
    by_id[row.id] = row
    local g = groups[typ]
    g[#g + 1] = row
    return true
end

local function concat(types)
    local out = {}
    for i = 1, #types do
        local g = groups[types[i]]
        if g then
            for j = 1, #g do
                out[#out + 1] = g[j]
            end
        end
    end
    return out
end

local function index_all()
    in_group = {}
    for typ, rows in pairs(groups) do
        local idx = {}
        for i = 1, #rows do
            local id = rows[i].id
            if id then
                idx[id] = true
            end
        end
        in_group[typ] = idx
    end
end

local function load_names()
    local data = decode_file("translations.json")
    names = {}
    if not data then
        printf("STALKER_DB: names missing")
        return
    end
    local lang = read_lang()
    if type(data[lang]) == "table" then
        names = data[lang]
        printf("STALKER_DB: names %s", lang)
        return
    end
    if type(data.en) == "table" then
        names = data.en
        printf("STALKER_DB: names en (no %s)", lang)
        return
    end
    printf("STALKER_DB: names missing")
end

local function pack_file_list()
    local listed = decode_file("pack-files.json")
    if type(listed) == "table" and listed[1] then
        return listed
    end
    local man = decode_file("manifest.json")
    if type(man) ~= "table" then
        return EMPTY
    end
    local out = {}
    for k in pairs(man) do
        if type(k) == "string" and string.sub(k, -5) == ".json" then
            out[#out + 1] = k
        end
    end
    return out
end

local function basename(file)
    return file:match("([^/\\]+)$") or file
end

local function slug(file)
    local base = basename(file)
    if base:sub(-5) ~= ".json" then
        return nil
    end
    return base:sub(1, #base - 5)
end

local function is_item_file(file, data)
    local base = basename(file)
    if SKIP_GROUP[base] then
        return false
    end
    if file:find("[/\\]") then
        return false
    end
    local items = data and data.items
    return items and items[1] and items[1].id
end

local function load_recipes()
    recipes = {}
    local data = decode_file("craft-recipes.json")
    if type(data) ~= "table" then
        return
    end
    local n = 0
    for _, cat in pairs(data) do
        local items = cat and cat.items
        if items then
            for i = 1, #items do
                local it = items[i]
                if it and it.id then
                    decorate(it)
                    recipes[it.id] = it
                    n = n + 1
                end
            end
        end
    end
    printf("STALKER_DB: craft recipes %s", n)
end

local function seal_public()
    by_id_raw = by_id
    local by_p = {}
    for id, row in pairs(by_id) do
        by_p[id] = seal_one(row)
    end
    by_id = by_p
    groups_raw = groups
    local groups_p = {}
    for typ, rows in pairs(groups) do
        local arr = {}
        for i = 1, #rows do
            arr[i] = seal_one(rows[i])
        end
        groups_p[typ] = arr
    end
    groups = groups_p
    recipes_raw = recipes
    local rec_p = {}
    for id, rec in pairs(recipes) do
        rec_p[id] = seal_one(rec)
    end
    recipes = rec_p
    json_sealed = {}
    for file, data in pairs(json_raw) do
        if data == false then
            json_sealed[file] = false
        elseif type(data) == "table" then
            json_sealed[file] = seal_one(data)
        else
            json_sealed[file] = data
        end
    end
    EMPTY = seal_one({})
    printf("STALKER_DB: sealed")
end

local function load_all()
    loaded = true
    by_id = {}
    groups = {}
    recipes = {}
    json_raw = {}
    json_sealed = {}
    list_sorted = {}
    load_names()
    local files = pack_file_list()
    local ok_files = 0
    local miss_files = 0
    local item_files = {}
    local misc_file = nil
    for i = 1, #files do
        local file = files[i]
        local data, err = decode_file(file)
        if data then
            ok_files = ok_files + 1
            if is_item_file(file, data) then
                if slug(file) == "misc" then
                    misc_file = file
                else
                    item_files[#item_files + 1] = file
                end
            end
        elseif err == "missing" then
            miss_files = miss_files + 1
        end
    end
    if misc_file then
        item_files[#item_files + 1] = misc_file
    end
    local n_items = 0
    for i = 1, #item_files do
        local file = item_files[i]
        local typ = slug(file)
        local data = decode_file(file)
        local items = type(data) == "table" and data.items
        if typ and items then
            groups[typ] = {}
            for j = 1, #items do
                if add_row(typ, items[j]) then
                    n_items = n_items + 1
                end
            end
        end
    end
    for name, types in pairs(UNIONS) do
        groups[name] = concat(types)
    end
    index_all()
    load_recipes()
    seal_public()
    printf("STALKER_DB: loaded %s items from %s groups, %s files (%s missing)", n_items, #item_files, ok_files, miss_files)
end

function init()
    if not loaded then
        load_all()
    end
end

local function cmp(key, desc)
    return function(a, b)
        local va, vb = a[key], b[key]
        local na, nb = tonumber(va), tonumber(vb)
        if na and nb then
            va, vb = na, nb
        else
            va = tostring(va or "")
            vb = tostring(vb or "")
        end
        if va == vb then
            return false
        end
        if desc then
            return va > vb
        end
        return va < vb
    end
end

function get(id, typ)
    init()
    if not id then
        return nil
    end
    local row = by_id[id]
    if not row then
        return nil
    end
    if typ then
        local idx = in_group[typ]
        if not (idx and idx[id]) then
            return nil
        end
    end
    return row
end

function is(id, typ)
    init()
    if not (id and typ) then
        return false
    end
    local idx = in_group[typ]
    return idx and idx[id] == true
end

function is_any(id, types)
    if not (id and types) then
        return false
    end
    for i = 1, #types do
        if is(id, types[i]) then
            return true
        end
    end
    return false
end

function translate(key)
    init()
    return tr(key)
end

function json(file)
    init()
    if not file then
        return nil
    end
    file = norm_file(file)
    local s = json_sealed[file]
    if s ~= nil then
        if s == false then
            return nil
        end
        return s
    end
    local data = decode_file(file)
    if not data then
        json_sealed[file] = false
        return nil
    end
    s = seal_one(data)
    json_sealed[file] = s
    return s
end

function craft(id)
    init()
    return id and recipes[id] or nil
end

function list(typ, sort, dir)
    init()
    local src = typ and groups[typ]
    if not src then
        return EMPTY
    end
    if not sort then
        return src
    end
    local key = typ .. "\0" .. sort .. "\0" .. (dir or "")
    local hit = list_sorted[key]
    if hit then
        return hit
    end
    local out = {}
    for i = 1, #src do
        out[i] = src[i]
    end
    table.sort(out, cmp(sort, dir == "desc"))
    list_sorted[key] = out
    return out
end

local function dcopy(v, seen)
    if type(v) ~= "table" then
        return v
    end
    local hit = seen[v]
    if hit then
        return hit
    end
    local o = {}
    seen[v] = o
    for k, x in pairs(v) do
        o[k] = dcopy(x, seen)
    end
    return o
end

local function make_handle()
    local h_by_id = {}
    local h_groups = {}
    local h_json = {}
    local h_recipes = {}
    local h_sorted = {}
    local h = {}

    function h.init()
        init()
    end

    function h.get(id, typ)
        init()
        if not id then
            return nil
        end
        local row = h_by_id[id]
        if not row then
            local raw = by_id_raw[id]
            if not raw then
                return nil
            end
            row = dcopy(raw, {})
            h_by_id[id] = row
        end
        if typ then
            local idx = in_group[typ]
            if not (idx and idx[id]) then
                return nil
            end
        end
        return row
    end

    function h.list(typ, sort, dir)
        init()
        if not typ then
            return EMPTY
        end
        local src = h_groups[typ]
        if not src then
            local raw = groups_raw[typ]
            if not raw then
                return EMPTY
            end
            src = {}
            for i = 1, #raw do
                local r = raw[i]
                local id = r.id
                local row = id and h_by_id[id]
                if not row then
                    row = dcopy(r, {})
                    if id then
                        h_by_id[id] = row
                    end
                end
                src[i] = row
            end
            h_groups[typ] = src
        end
        if not sort then
            return src
        end
        local key = typ .. "\0" .. sort .. "\0" .. (dir or "")
        local hit = h_sorted[key]
        if hit then
            return hit
        end
        local out = {}
        for i = 1, #src do
            out[i] = src[i]
        end
        table.sort(out, cmp(sort, dir == "desc"))
        h_sorted[key] = out
        return out
    end

    function h.json(file)
        init()
        if not file then
            return nil
        end
        file = norm_file(file)
        local cached = h_json[file]
        if cached ~= nil then
            if cached == false then
                return nil
            end
            return cached
        end
        local data = decode_file(file)
        if not data then
            h_json[file] = false
            return nil
        end
        local copy = dcopy(data, {})
        h_json[file] = copy
        return copy
    end

    function h.craft(id)
        init()
        if not id then
            return nil
        end
        local cached = h_recipes[id]
        if cached ~= nil then
            if cached == false then
                return nil
            end
            return cached
        end
        local raw = recipes_raw[id]
        if not raw then
            h_recipes[id] = false
            return nil
        end
        local copy = dcopy(raw, {})
        h_recipes[id] = copy
        return copy
    end

    h.is = is
    h.is_any = is_any
    h.translate = translate
    return h
end

function open(mod_id)
    if not can_open then
        printf("STALKER_DB: open refused (game running)")
        return nil
    end
    if type(mod_id) ~= "string" or mod_id == "" then
        printf("STALKER_DB: open refused (empty id)")
        return nil
    end
    init()
    local h = views[mod_id]
    if h then
        return h
    end
    view_n = view_n + 1
    h = make_handle()
    views[mod_id] = h
    printf("STALKER_DB: open %s views=%s", mod_id, view_n)
    if view_n > 16 then
        printf("STALKER_DB: open warn many views")
    end
    return h
end

local function allow_open()
    can_open = true
end

local function deny_open()
    if can_open then
        printf("STALKER_DB: open closed")
    end
    can_open = false
end

function on_game_load()
    allow_open()
end

function actor_on_first_update()
    deny_open()
end

local cbs_bound = false

function on_game_start()
    init()
    if RegisterScriptCallback and not cbs_bound then
        cbs_bound = true
        RegisterScriptCallback("on_game_load", allow_open)
        RegisterScriptCallback("actor_on_first_update", deny_open)
    end
end

rawset(_G, "STALKER_DB", stalker_db)
